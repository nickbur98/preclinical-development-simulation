  document.getElementById('reflection').classList.add('hidden');
  document.getElementById('q1').value='';document.getElementById('q2').value='';document.getElementById('q3').value='';
  const fbGood=document.getElementById('fbGood'); if(fbGood) fbGood.value='';
  const fbImprove=document.getElementById('fbImprove'); if(fbImprove) fbImprove.value='';
