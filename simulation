button{border:0;border-radius:10px;padding:11px 16px;font-weight:700;font-size:15px;cursor:pointer}.primary{background:var(--red);color:#fff}.secondary{background:#eee}.danger{background:#fff1f2;color:var(--red);border:1px solid #f1c6cc}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
