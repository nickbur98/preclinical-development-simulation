  const fbSaved=document.getElementById('feedbackSaved'); if(fbSaved) fbSaved.classList.add('hidden');
  const fbError=document.getElementById('feedbackError'); if(fbError) fbError.classList.add('hidden');
  const submitAllBtn=document.getElementById('submitAllBtn'); if(submitAllBtn){submitAllBtn.disabled=false;submitAllBtn.textContent='Open Microsoft Form to submit';}
  closeReview();show('intro');progress(0,'Candidate dossier');
}
